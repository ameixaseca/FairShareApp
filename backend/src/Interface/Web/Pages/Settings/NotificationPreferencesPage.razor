@page "/settings/notifications"
@inject FairShareApp.Backend.Web.Services.ApiClients.SettlementsApiClient SettlementsApiClient

<h1>Notification Preferences</h1>

<div class="card financial-card">
    <label><input type="checkbox" @bind="_inApp" /> In-app</label>
    <label><input type="checkbox" @bind="_email" /> Email</label>
    <label><input type="checkbox" @bind="_telegram" /> Telegram</label>
    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
</div>

@code {
    private readonly Guid _groupId = Guid.Empty;

    private bool _inApp = true;
    private bool _email;
    private bool _telegram;

    protected override async Task OnInitializedAsync()
    {
        var preferences = await SettlementsApiClient.GetPreferencesAsync(_groupId);
        if (preferences is null)
        {
            return;
        }

        _inApp = preferences.InAppEnabled;
        _email = preferences.EmailEnabled;
        _telegram = preferences.TelegramEnabled;
    }

    private Task SaveAsync()
    {
        var request = new FairShareApp.Backend.Web.Models.Settlements.UpdateNotificationPreferenceRequest(_inApp, _email, _telegram);
        return SettlementsApiClient.UpdatePreferencesAsync(_groupId, request);
    }
}
