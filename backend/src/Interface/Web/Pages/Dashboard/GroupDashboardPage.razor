@page "/groups/{GroupId:guid}"
@using FairShareApp.Backend.Web.Models.Dashboard
@inject FairShareApp.Backend.Web.Services.ApiClients.BalancesApiClient BalancesApiClient
@inject FairShareApp.Backend.Web.Services.Caching.ViewCacheService CacheService

<h1>Dashboard</h1>

<FairShareApp.Backend.Web.Components.Dashboard.ProjectionFreshnessBanner LastProjectionUtc="_lastRefreshUtc" OnRefresh="LoadAsync" />

<div class="fs-grid-2">
    <section class="card financial-card">
        <h2>Balances</h2>
        <ul class="fs-list">
            @foreach (var balance in _balances)
            {
                var css = balance.NetBalance >= 0 ? "amount-positive" : "amount-negative";
                <li><span>@balance.DisplayName</span> <span class="amount @css">@balance.NetBalance.ToString("C")</span></li>
            }
        </ul>
    </section>

    <section class="card financial-card">
        <h2>Obligations</h2>
        <FairShareApp.Backend.Web.Components.Dashboard.ObligationsGrid Items="_obligations" />
    </section>
</div>

@code {
    [Parameter] public Guid GroupId { get; set; }

    private IReadOnlyList<BalanceView> _balances = [];
    private IReadOnlyList<ObligationView> _obligations = [];
    private DateTimeOffset _lastRefreshUtc = DateTimeOffset.UtcNow;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (GroupId == Guid.Empty)
        {
            _balances = [];
            _obligations = [];
            return;
        }

        var balanceKey = $"group:{GroupId}:dashboard:balances";
        var obligationKey = $"group:{GroupId}:dashboard:obligations";

        if (!CacheService.TryGet(balanceKey, out IReadOnlyList<BalanceView>? cachedBalances))
        {
            cachedBalances = await BalancesApiClient.GetBalancesAsync(GroupId);
            CacheService.Set(balanceKey, cachedBalances, TimeSpan.FromSeconds(30));
        }

        if (!CacheService.TryGet(obligationKey, out IReadOnlyList<ObligationView>? cachedObligations))
        {
            cachedObligations = await BalancesApiClient.GetObligationsAsync(GroupId);
            CacheService.Set(obligationKey, cachedObligations, TimeSpan.FromSeconds(30));
        }

        _balances = cachedBalances ?? [];
        _obligations = cachedObligations ?? [];
        _lastRefreshUtc = DateTimeOffset.UtcNow;
    }
}
