@page "/groups"
@using FairShareApp.Backend.Web.Models.Groups
@inject FairShareApp.Backend.Web.Services.ApiClients.GroupsApiClient GroupsApiClient

<h1>Groups</h1>

<div class="fs-grid-2">
    <div class="card financial-card">
        <h2>Create Group</h2>
        <input class="form-control" placeholder="Name" @bind="_newName" />
        <input class="form-control" placeholder="Currency" @bind="_newCurrency" />
        <button class="btn btn-primary" @onclick="CreateGroupAsync">Create</button>
    </div>

    <div class="card financial-card">
        <h2>My Groups</h2>
        <ul class="fs-list">
            @foreach (var group in _groups)
            {
                <li><a href="@($"/groups/{group.Id}")">@group.Name (@group.Currency)</a></li>
            }
        </ul>
    </div>
</div>

@code {
    private IReadOnlyList<GroupSummary> _groups = [];
    private string _newName = "Weekend Trip";
    private string _newCurrency = "USD";

    protected override async Task OnInitializedAsync()
    {
        _groups = await GroupsApiClient.GetGroupsAsync();
    }

    private async Task CreateGroupAsync()
    {
        var created = await GroupsApiClient.CreateGroupAsync(new CreateGroupRequest(_newName, _newCurrency));
        if (created is not null)
        {
            _groups = [.._groups, created];
        }
    }
}
