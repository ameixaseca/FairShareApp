@using FairShareApp.Backend.Web.Models.Dashboard

<table class="table fs-table">
    <thead>
        <tr>
            <th>From</th>
            <th>To</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Items)
        {
            <tr>
                <td>@item.FromName</td>
                <td>@item.ToName</td>
                <td class="amount amount-negative">@item.Amount.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public IReadOnlyList<ObligationView> Items { get; set; } = [];
}
