@using Microsoft.AspNetCore.Components.Authorization

@if (_isReady)
{
    if (_isAuthenticated)
    {
        <Microsoft.AspNetCore.Components.Authorization.AuthorizeRouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
    }
    else
    {
        <LayoutView Layout="DefaultLayout">
            <p class="fs-callout-warning">You must sign in to view this route.</p>
        </LayoutView>
    }
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter] public Type DefaultLayout { get; set; } = typeof(Layout.MainLayout);

    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    private bool _isAuthenticated;
    private bool _isReady;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        _isReady = true;
    }
}
