@using FairShareApp.Backend.Web.Models.Expenses
@inject FairShareApp.Backend.Web.Services.ApiClients.ExpensesApiClient ExpensesApiClient
@inject FairShareApp.Backend.Web.Services.Validation.ExpenseValidators Validators
@inject FairShareApp.Backend.Web.Services.Caching.ExpenseMutationCacheHandler CacheHandler

<div class="card financial-card">
    <h3>Quick Expense Entry</h3>
    <label>Description</label>
    <input class="form-control" @bind="_description" />
    <label>Amount</label>
    <input class="form-control" type="number" step="0.01" @bind="_amount" />
    <button class="btn btn-primary" @onclick="CreateExpenseAsync">Submit</button>

    @if (_errors.Count > 0)
    {
        <ul class="text-danger">
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public Guid GroupId { get; set; }

    private string _description = string.Empty;
    private decimal _amount;
    private List<string> _errors = [];

    private async Task CreateExpenseAsync()
    {
        var validation = Validators.Validate(_amount, _description);
        _errors = validation.Errors.ToList();
        if (!validation.IsValid || GroupId == Guid.Empty)
        {
            return;
        }

        var request = new CreateExpenseRequest(GroupId, _amount, _description, Guid.Empty, []);
        await ExpensesApiClient.CreateExpenseAsync(request);
        CacheHandler.HandleMutation(GroupId);
        _description = string.Empty;
        _amount = 0;
    }
}
